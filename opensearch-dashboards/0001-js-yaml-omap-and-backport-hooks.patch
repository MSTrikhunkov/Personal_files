diff --git a/scripts/security_backports/apply.cjs b/scripts/security_backports/apply.cjs
--- /dev/null
+++ b/scripts/security_backports/apply.cjs
@@ -0,0 +1,98 @@
+/* Copyright OpenSearch Contributors. SPDX-License-Identifier: Apache-2.0 */
+'use strict';
+
+// Security backports deliberately retain the dependency versions in yarn.lock.
+// Verify every input before writing anything; never silently patch an unknown file.
+const fs = require('fs');
+const path = require('path');
+const crypto = require('crypto');
+const hash = text => crypto.createHash('sha256').update(text).digest('hex');
+
+function apply(root, { check = false } = {}) {
+  root = fs.realpathSync(root);
+  const recipes = fs.readdirSync(__dirname)
+    .filter(name => name.endsWith('.json'))
+    .flatMap(name => JSON.parse(fs.readFileSync(path.join(__dirname, name), 'utf8')));
+  const names = new Set(recipes.map(recipe => recipe.name));
+  const seen = new Set();
+  const prepared = new Set();
+  const planned = new Map();
+  let packages = 0;
+
+  function prepare(dir, pkg) {
+    const recipe = recipes.find(item => item.name === pkg.name && item.version === pkg.version);
+    if (!recipe) throw new Error(`Unsupported security backport target: ${pkg.name}@${pkg.version} (${dir})`);
+    packages++;
+    for (const file of recipe.files) {
+      const target = path.join(dir, file.path);
+      // Refuse symlinked files: the patch must not modify another package or cache.
+      if (!fs.lstatSync(target).isFile()) throw new Error(`Not a regular file: ${target}`);
+      const before = fs.readFileSync(target, 'utf8');
+      if (hash(before) === file.after) continue;
+      if (hash(before) !== file.before) throw new Error(`Unexpected content: ${target}`);
+      let after = before;
+      for (const edit of file.edits) {
+        const parts = after.split(edit.from);
+        if (parts.length - 1 !== edit.count) throw new Error(`Unexpected match count: ${target}`);
+        after = parts.join(edit.to);
+      }
+      if (hash(after) !== file.after) throw new Error(`Invalid backport output: ${target}`);
+      planned.set(target, after);
+    }
+  }
+
+  function walk(dir) {
+    const real = fs.realpathSync(dir);
+    if (real !== root && !real.startsWith(root + path.sep)) {
+      // External workspace links are not part of this source/distribution tree.
+      return;
+    }
+    const parent = path.dirname(dir);
+    const packageRoot = path.basename(parent) === 'node_modules' ||
+      (path.basename(parent).startsWith('@') && path.basename(path.dirname(parent)) === 'node_modules');
+    const manifest = path.join(real, 'package.json');
+    if (packageRoot && !prepared.has(real) && fs.existsSync(manifest)) {
+      const pkg = JSON.parse(fs.readFileSync(manifest, 'utf8'));
+      if (names.has(pkg.name)) {
+        prepare(real, pkg);
+        prepared.add(real);
+      }
+    }
+    if (seen.has(real)) return;
+    seen.add(real);
+    for (const entry of fs.readdirSync(real, { withFileTypes: true })) {
+      if (entry.name === '.git' || entry.name === '.yarn-cache') continue;
+      const child = path.join(real, entry.name);
+      if (entry.isDirectory()) walk(child);
+      else if (entry.isSymbolicLink()) {
+        // Workspace links can be cycles or dangling optional dependencies.
+        try { if (fs.statSync(child).isDirectory()) walk(child); }
+        catch (e) { if (e.code !== 'ENOENT') throw e; }
+      }
+    }
+  }
+
+  walk(root);
+  if (!packages) throw new Error(`No supported installed dependencies found under ${root}`);
+  if (check && planned.size) throw new Error(`${planned.size} files still need security backports`);
+  if (!check) {
+    for (const [file, content] of planned) {
+      // Rename rather than overwrite: protect files hard-linked to Yarn's cache.
+      const temp = `${file}.osd-security-${process.pid}.tmp`;
+      try {
+        fs.writeFileSync(temp, content, { flag: 'wx', mode: fs.statSync(file).mode });
+        fs.renameSync(temp, file);
+      } finally {
+        if (fs.existsSync(temp)) fs.unlinkSync(temp);
+      }
+    }
+  }
+  console.log(`Security backports: ${packages} packages checked, ${planned.size} files patched`);
+  return { packages, files: planned.size };
+}
+
+module.exports = { apply };
+if (require.main === module) {
+  try { apply(process.argv[2] || process.cwd(), { check: process.argv.includes('--check') }); }
+  catch (e) { console.error(e.message); process.exitCode = 1; }
+}
