-void PyUpb_RepeatedContainer_Reify(PyObject* self, upb_Array* arr);
+upb_Array* PyUpb_RepeatedContainer_Reify(PyObject* self, upb_Array* arr,
+                                         PyUpb_WeakMap* subobj_map,
