diff --git a/tests/test_upb_stub_lifetime.py b/tests/test_upb_stub_lifetime.py
new file mode 100644
index 0000000..f63dbcf
--- /dev/null
+++ b/tests/test_upb_stub_lifetime.py
@@ -0,0 +1,40 @@
+"""Regression for upstream 42749093: retained container after parent Clear."""
+from pathlib import Path
+import subprocess
+import sys
+import unittest
+
+
+class StubLifetimeTest(unittest.TestCase):
+    def test_retained_map_and_repeated_containers(self):
+        code = '''
+import gc
+from google.protobuf import descriptor_pb2, descriptor_pool, message_factory
+f = descriptor_pb2.FileDescriptorProto(name='stub.proto', syntax='proto3')
+m = f.message_type.add(name='M')
+entry = m.nested_type.add(name='Entry')
+entry.options.map_entry = True
+entry.field.add(name='key', number=1, type=9, label=1)
+entry.field.add(name='value', number=2, type=5, label=1)
+m.field.add(name='mapping', number=1, type=11, type_name='.M.Entry', label=3)
+m.field.add(name='items', number=2, type=5, label=3)
+m.field.add(name='child', number=3, type=11, type_name='.M', label=1)
+pool = descriptor_pool.DescriptorPool()
+pool.Add(f)
+cls = message_factory.GetMessageClass(pool.FindMessageTypeByName('M'))
+for field in ('mapping', 'items'):
+    for _ in range(10):
+        msg = cls()
+        ref = getattr(msg.child, field)
+        msg.Clear()
+        del ref, msg
+        gc.collect()
+'''
+        result = subprocess.run([sys.executable, '-B', '-c', code],
+                                cwd=str(Path(__file__).resolve().parents[1]),
+                                capture_output=True, text=True, timeout=20)
+        self.assertEqual(result.returncode, 0, result.stderr)
+
+
+if __name__ == '__main__':
+    unittest.main()
